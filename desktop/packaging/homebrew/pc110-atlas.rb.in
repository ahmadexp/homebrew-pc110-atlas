cask "pc110-atlas" do
  arch arm: "arm64", intel: "x64"

  version "@VERSION@"
  sha256 arm:   "@MAC_ARM64_SHA256@",
         intel: "@MAC_X64_SHA256@"

  url "https://github.com/@REPOSITORY@/releases/download/desktop-v#{version}/pc110-atlas-#{version}-macos-#{arch}.dmg"
  name "PC110 Atlas"
  desc "Interactive companion and emulator for the IBM Palm Top PC 110"
  homepage "https://github.com/@REPOSITORY@"

  depends_on macos: ">= :monterey"

  app "PC110 Atlas.app"

  zap trash: "~/Library/Application Support/PC110 Atlas"
end
